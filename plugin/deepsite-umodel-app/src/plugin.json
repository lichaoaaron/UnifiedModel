{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Umodel",
  "id": "deepsite-umodel-app",
  "backend": true,
  "executable": "gpx_umodel",
  "info": {
    "keywords": ["app"],
    "description": "",
    "author": {
      "name": "Deepsite"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "UModel",
      "path": "/a/%PLUGIN_ID%/umodel",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Topology",
      "path": "/a/%PLUGIN_ID%/entity-topo",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Query",
      "path": "/a/%PLUGIN_ID%/query",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Imports",
      "path": "/a/%PLUGIN_ID%/imports",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Settings",
      "path": "/a/%PLUGIN_ID%/settings",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "API Debugger",
      "path": "/a/%PLUGIN_ID%/api-debug",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "Diagnosis",
      "path": "/a/%PLUGIN_ID%/diagnosis",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
